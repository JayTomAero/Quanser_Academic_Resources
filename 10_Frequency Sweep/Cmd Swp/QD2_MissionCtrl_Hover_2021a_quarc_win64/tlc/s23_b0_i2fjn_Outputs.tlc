rtb_Relation = ((real_T)rtb_Relation >= QD2_MissionCtrl_Hover_2021a_P.Threshold_threshold_p);
/* {S!d3188}Logic: '<S21>/Logical Operator' */
QD2_MissionCtrl_Hover_2021a_B.LogicalOperator = !rtb_Relation;
/* {S!d3190}DiscreteIntegrator: '<S21>/Discrete-Time Integrator' */
if (QD2_MissionCtrl_Hover_2021a_B.LogicalOperator || (QD2_MissionCtrl_Hover_2021a_DW.DiscreteTimeIntegrator_PrevRese != 0)) {
