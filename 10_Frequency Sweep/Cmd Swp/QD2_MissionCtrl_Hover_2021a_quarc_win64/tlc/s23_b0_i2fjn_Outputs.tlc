    QD2_MissionCtrl_Hover_2021a_B.FixPtSum1 = (QD2_MissionCtrl_Hover_2021a_P.Constant1_Value_p + QD2_MissionCtrl_Hover_2021a_DW.UnitDelay_DSTATE) + QD2_MissionCtrl_Hover_2021a_P.FixPtConstant_Value;
