 */
    QD2_MissionCtrl_Hover_2021a_B.RelationalOperator = (QD2_MissionCtrl_Hover_2021a_B.DiscreteTimeIntegrator >= QD2_MissionCtrl_Hover_2021a_P.Threshold_duration);
    /* {S!d3208}Gain: '<S18>/Gain' */
    QD2_MissionCtrl_Hover_2021a_B.Gain_h = QD2_MissionCtrl_Hover_2021a_P.Gain_Gain * rtb_HostGameController_o7;
    /* {S!d3210}Bias: '<S18>/Bias' incorporates:
