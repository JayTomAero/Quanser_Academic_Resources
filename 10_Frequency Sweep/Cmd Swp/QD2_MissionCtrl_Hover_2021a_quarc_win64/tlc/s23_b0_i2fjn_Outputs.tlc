 */
if (QD2_MissionCtrl_Hover_2021a_B.HostGameController_o1 && (QD2_MissionCtrl_Hover_2_PrevZCX.pulsecount_Trig_ZCE != POS_ZCSIG)) {
    /* {S!d3222}Sum: '<S25>/FixPt Sum1' incorporates:
