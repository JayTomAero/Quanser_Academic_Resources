 */
    QD2_MissionCtrl_Hover_2021a_B.Bias = QD2_MissionCtrl_Hover_2021a_P.Gain1_Gain * rtb_HostGameController_o4 + QD2_MissionCtrl_Hover_2021a_P.Bias_Bias;
