 */
    rtb_Compare_a = ((real_T)QD2_MissionCtrl_Hover_2021a_B.Buttons[0] >= QD2_MissionCtrl_Hover_2021a_P.Threshold_threshold);
    /* {S!d3198}DataTypeConversion: '<S23>/Data Type Conversion' */
