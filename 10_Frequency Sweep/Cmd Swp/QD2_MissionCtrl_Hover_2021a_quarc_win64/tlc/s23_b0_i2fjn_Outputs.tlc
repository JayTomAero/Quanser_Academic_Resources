/* {S!d3262}ManualSwitch: '<S2>/Manual Switch1' */
if (QD2_MissionCtrl_Hover_2021a_P.ManualSwitch1_CurrentSetting == 1) {
    /* {S!d3258}ManualSwitch: '<S2>/Manual Switch1' */
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[0] = QD2_MissionCtrl_Hover_2021a_B.Product2;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[1] = QD2_MissionCtrl_Hover_2021a_B.Product3;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[2] = QD2_MissionCtrl_Hover_2021a_B.DataTypeConversion2_i;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[3] = QD2_MissionCtrl_Hover_2021a_B.DataTypeConversion4;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[4] = QD2_MissionCtrl_Hover_2021a_B.OutportBufferForJoystickIssue01;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[5] = QD2_MissionCtrl_Hover_2021a_B.Product1;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[6] = QD2_MissionCtrl_Hover_2021a_B.Product_n[0];
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[7] = QD2_MissionCtrl_Hover_2021a_B.Product_n[1];
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[8] = QD2_MissionCtrl_Hover_2021a_B.Product_n[2];
} else {
    /* {S!d3260}ManualSwitch: '<S2>/Manual Switch1' */
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[0] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[1] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[2] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[3] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[4] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[5] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[6] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[7] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
    QD2_MissionCtrl_Hover_2021a_B.ManualSwitch1[8] = %<(SLibCG_SE(SLibCG_Grnd(0, 0, 1, "", -1, "", 0)))>;
}
/* {E!d3262}End of ManualSwitch: '<S2>/Manual Switch1' */

/* {S!d3266}RateTransition: '<S11>/Rate Transition2' */
if (%<(LibIsSpecialSampleHit(2, 1))>) {
    /* {S!d3264}RateTransition: '<S11>/Rate Transition2' */
    for (i = 0; i < 7; i++) {
        QD2_MissionCtrl_Hover_2021a_B.RateTransition2[i] = QD2_MissionCtrl_Hover_2021a_DW.RateTransition2_Buffer0[i];
    }
}
/* {E!d3266}End of RateTransition: '<S11>/Rate Transition2' */
for (i = 0; i < 7; i++) {
    /* {S!d3268}Reshape: '<S11>/Reshape1' incorporates:
 *  RateTransition: '<S11>/Rate Transition2'
 */
    QD2_MissionCtrl_Hover_2021a_B.Reshape1[i] = QD2_MissionCtrl_Hover_2021a_B.RateTransition2[i];
}
/* {S!d3270}DataTypeConversion: '<S12>/Data Type Conversion2' */
QD2_MissionCtrl_Hover_2021a_B.DataTypeConversion2 = QD2_MissionCtrl_Hover_2021a_B.Reshape1[6];
/* {S!d3272}Bias: '<S12>/Subtract Rigid Body Reference Offset  (Initial Height)  to get height above the ground' */
rtb_Time_e = QD2_MissionCtrl_Hover_2021a_B.Reshape1[0] + QD2_MissionCtrl_Hover_2021a_P.SubtractRigidBodyReferenceOffse[0];
/* {S!d3280}Saturate: '<S12>/Saturation' */
if (rtb_Time_e > QD2_MissionCtrl_Hover_2021a_P.Saturation_UpperSat[0]) {
    /* {S!d3274}Saturate: '<S12>/Saturation' */
    QD2_MissionCtrl_Hover_2021a_B.Saturation[0] = QD2_MissionCtrl_Hover_2021a_P.Saturation_UpperSat[0];
} else if (rtb_Time_e < QD2_MissionCtrl_Hover_2021a_P.Saturation_LowerSat[0]) {
    /* {S!d3276}Saturate: '<S12>/Saturation' */
