    /* {S!d3200}Logic: '<S23>/Logical Operator' */
    QD2_MissionCtrl_Hover_2021a_B.LogicalOperator_n = !rtb_Compare_a;
    /* {S!d3202}DiscreteIntegrator: '<S23>/Discrete-Time Integrator' */
    if (QD2_MissionCtrl_Hover_2021a_B.LogicalOperator_n || (QD2_MissionCtrl_Hover_2021a_DW.DiscreteTimeIntegrator_PrevRe_i != 0)) {
        QD2_MissionCtrl_Hover_2021a_DW.DiscreteTimeIntegrator_DSTATE_h = QD2_MissionCtrl_Hover_2021a_P.DiscreteTimeIntegrator_IC;
